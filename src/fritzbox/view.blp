using Gtk 4.0;
using Adw 1;

template $TvFritzView: Adw.Bin {
  Gtk.Stack stack {
    Gtk.StackPage {
      name: "spinner";

      child: Adw.Spinner spinner {
        halign: center;
        valign: center;
        width-request: 32;
        height-request: 32;
      };
    }

    Gtk.StackPage {
      name: "channels";

      child: Adw.ToolbarView {
        [top]
        Adw.Clamp {
          Gtk.Box {
            margin-top: 6;
            margin-bottom: 6;
            margin-start: 6;
            margin-end: 6;

            Gtk.SearchEntry search_entry {
              placeholder-text: _("Filter channels");
              hexpand: true;
            }
          }
        }

        Gtk.Stack results_stack {
          Gtk.StackPage {
            name: "list";

            child: Gtk.ScrolledWindow {
              hscrollbar-policy: never;

              Adw.Clamp {
                Gtk.Box {
                  orientation: vertical;
                  spacing: 24;
                  margin-top: 12;
                  margin-bottom: 12;
                  margin-start: 12;
                  margin-end: 12;

                  Adw.PreferencesGroup tv_group {
                    title: _("TV");

                    Gtk.ListBox tv_list {
                      selection-mode: none;

                      styles [
                        "boxed-list"
                      ]
                    }
                  }

                  Adw.PreferencesGroup hd_group {
                    title: _("HD");

                    Gtk.ListBox hd_list {
                      selection-mode: none;

                      styles [
                        "boxed-list"
                      ]
                    }
                  }

                  Adw.PreferencesGroup sd_group {
                    title: _("SD");

                    Gtk.ListBox sd_list {
                      selection-mode: none;

                      styles [
                        "boxed-list"
                      ]
                    }
                  }

                  Adw.PreferencesGroup radio_group {
                    title: _("Radio");

                    Gtk.ListBox radio_list {
                      selection-mode: none;

                      styles [
                        "boxed-list"
                      ]
                    }
                  }
                }
              }
            };
          }

          Gtk.StackPage {
            name: "no-matches";

            child: Adw.StatusPage {
              icon-name: "item-missing-symbolic";
              title: _("No Matching Channels");
              description: _("Try a different channel name");
            };
          }
        }
      };
    }

    Gtk.StackPage {
      name: "empty";

      child: Adw.StatusPage {
        icon-name: "cable-tv-symbolic";
        title: _("No Channels Found");
        description: _("Run a channel scan in the DVB-C settings of your FRITZ!Box, then reload.");

        child: Gtk.Button {
          label: _("Reload");
          halign: center;
          action-name: "window.reload";

          styles [
            "pill"
          ]
        };
      };
    }

    Gtk.StackPage {
      name: "error";

      child: Adw.StatusPage error_page {
        icon-name: "error-symbolic";
        title: _("Could Not Load Channels");

        child: Gtk.Box {
          orientation: horizontal;
          halign: center;
          spacing: 12;

          Gtk.Button {
            label: _("Preferences");
            action-name: "app.preferences";

            styles [
              "pill"
            ]
          }

          Gtk.Button {
            label: _("Retry");
            action-name: "window.reload";

            styles [
              "pill",
              "suggested-action"
            ]
          }
        };
      };
    }
  }
}
