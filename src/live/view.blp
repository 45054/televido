using Gtk 4.0;
using Adw 1;

template $TvLiveView: Adw.Bin {
  Gtk.Stack stack {
    visible-child: spinner;

    Gtk.StackPage {
      name: "spinner";

      child: Gtk.Spinner spinner {
        halign: center;
        spinning: true;
      };
    }

    Gtk.StackPage {
      name: "channels";

      child: Adw.ToolbarView {
        [top]
        Adw.Clamp {
          Gtk.Box {
            margin-top: 6;
            margin-bottom: 6;
            margin-start: 6;
            margin-end: 6;

            Gtk.SearchEntry search_entry {
              placeholder-text: _("Filter channels");
              hexpand: true;
            }
          }
        }

        Gtk.Stack results_stack {
          Gtk.StackPage {
            name: "list";

            child: Gtk.ScrolledWindow {
              Adw.Clamp {
                Gtk.ListBox channels_list {
                  margin-top: 12;
                  margin-bottom: 12;
                  margin-start: 12;
                  margin-end: 12;
                  valign: start;

                  styles [
                    "boxed-list"
                  ]
                }
              }
            };
          }

          Gtk.StackPage {
            name: "no-matches";

            child: Adw.StatusPage {
              icon-name: "item-missing-symbolic";
              title: _("No Matching Channels");
              description: _("Try a different channel name");
            };
          }
        }
      };
    }
  }
}
