using Gtk 4.0;
using Adw 1;

template $TvPreferencesDialog: Adw.PreferencesDialog {
  Adw.PreferencesPage {
    Adw.PreferencesGroup {
      title: _("External Programs");
      name: "external-programs";

      Adw.SwitchRow {
        title: _("Use external video player");
        active: bind template.use-external-player bidirectional;
      }

      Adw.ActionRow video_player_row {
        title: _("Video Player");
        subtitle: bind template.video-player-display-name;
        visible: bind template.use-external-player;

        Gtk.Button {
          label: _("Change");
          valign: center;
          clicked => $select_video_player() swapped;
        }
      }

      Adw.ActionRow video_downloader_row {
        title: _("Video Downloader");
        subtitle: bind template.video-downloader-display-name;

        Gtk.Button {
          label: _("Change");
          valign: center;
          clicked => $select_video_downloader() swapped;
        }
      }
    }

    Adw.PreferencesGroup {
      title: _("Live Channels");
      name: "live-channels";

      Adw.ActionRow {
        title: _("Select and reorder channels");
        activatable: true;
        activated => $select_live_channels() swapped;

        Gtk.Image {
          icon-name: "go-next-symbolic";
        }
      }
    }

    Adw.PreferencesGroup {
      title: _("FritzTV");
      description: _("Watch the DVB-C channels of a FRITZ!Box Cable with mpv. If “fritz.box” does not work, enter the IP address of your FRITZ!Box, e.g. 192.168.178.1.");
      name: "fritztv";

      Adw.ActionRow {
        title: _("mpv is not installed");
        subtitle: _("FritzTV needs the mpv video player");
        visible: bind template.mpv-missing;

        [prefix]
        Gtk.Image {
          icon-name: "dialog-warning-symbolic";

          styles [
            "warning"
          ]
        }
      }

      Adw.SwitchRow {
        title: _("Show FritzTV");
        active: bind template.fritztv-enabled bidirectional;
      }

      Adw.EntryRow fritzbox_address_row {
        title: _("FRITZ!Box Address");
        show-apply-button: true;
        sensitive: bind template.fritztv-enabled;
        apply => $apply_fritzbox_address() swapped;
      }

      Adw.SwitchRow {
        title: _("Show radio channels");
        active: bind template.fritztv-show-radio bidirectional;
        sensitive: bind template.fritztv-enabled;
      }

      Adw.ActionRow {
        title: _("mpv Arguments");
        subtitle: bind template.mpv-arguments-summary;
        subtitle-lines: 1;
        activatable: true;
        sensitive: bind template.fritztv-enabled;
        activated => $edit_mpv_arguments() swapped;

        Gtk.Image {
          icon-name: "go-next-symbolic";
        }
      }
    }
  }
}
